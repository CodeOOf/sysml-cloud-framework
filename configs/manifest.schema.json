{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Configs Manifest",
  "type": "object",
  "required": ["id","displayName","type","owner"],
  "properties": {
    "id": {"type":"string","description":"Unique folder id (used by tooling)"},
    "displayName": {"type":"string"},
    "type": {"type":"string","enum":["kubernetes-cluster","terraform-module","network-site","other"]},
    "owner": {"type":"string"},
    "contact": {"type":"string"},
    "purpose": {"type":"string"},
    "relatedSysMLRequirements": {"type":"array","items":{"type":"string"}}
  }
}
