# Git Submodule Configuration for SysML Cloud Platform
#
# Format:
#   path = <relative/path/in/repo>    (path may point to a nested subfolder)
#   url  = <git-repository-url>
#
# This file defines which specific paths (typically subfolders under
# `fabrications/`, `configs/`, or `library/`) should be managed as
# git submodules. The top-level directories themselves remain part of
# this repository; individual subfolders inside them can be either
# committed locally or linked as submodules.
#
# To activate submodules:
#   make setup-submodules-init
#
# To convert a folder to a submodule manually:
#   git rm --cached <path>
#   git submodule add <url> <path>
#   git commit -m "Convert <path> to submodule"
#
# To convert a submodule back to a committed folder:
#   git submodule deinit <path>
#   git rm --cached <path>
#   rm -rf .git/modules/<path>
#   git add <path>
#   git commit -m "Convert <path> from submodule to committed folder"

# Examples (common pattern: subfolders under the top-level domains):
# The following example entries were converted to local folders during
# the repository migration. Keep them as examples or remove as needed.
#
# [submodule "fabrications/fabrication-datacenter-a"]
# 	path = fabrications/fabrication-datacenter-a
# 	url = 
#
# [submodule "configs/infrastructure-cluster-a"]
# 	path = configs/infrastructure-cluster-a
# 	url = 
#
# [submodule "library/ansible-roles"]
# 	path = library/ansible-roles
# 	url = 

# Note: Leave 'url' empty until you configure the actual repository URLs.
# Update URLs as you migrate these subfolders to separate git repositories.
