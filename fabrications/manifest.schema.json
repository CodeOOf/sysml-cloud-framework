{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fabrications Manifest",
  "type": "object",
  "required": ["id","displayName","type","owner","location"],
  "properties": {
    "id": {"type":"string","description":"Unique folder id (used by tooling)"},
    "displayName": {"type":"string"},
    "type": {"type":"string","enum":["datacenter","fabrication-site","lab","other"]},
    "owner": {"type":"string"},
    "contact": {"type":"string"},
    "location": {"type":"string"},
    "relatedSysMLRequirements": {"type":"array","items":{"type":"string"}}
  }
}
